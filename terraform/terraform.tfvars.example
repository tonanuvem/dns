# Modelo preenchido pelo config.sh (via envsubst). Nao edite o
# terraform.tfvars gerado a partir daqui: ele carrega a senha da turma
# e por isso fica fora do controle de versao.
#
# As variaveis api_gateway_* e frontend_* foram removidas: nao existem
# no root module -- os modulos recebem esses valores do main.tf -- e
# produziam seis avisos de "Value for undeclared variable" em todo
# init e plan.

# Configurações gerais
aws_region = "us-east-1"
ttl_dns    = 60

# Turma e domínio.
#
# nome_aluno nomeia a zona compartilhada da turma: os alunos criam
# <alias> dentro de <nome_aluno>.<nome_dominio>.
nome_aluno   = "${NOME_ALUNO}"
nome_dominio = "${NOME_DOMINIO}"

# Senha compartilhada para autenticação na API.
#
# Ela e embutida no bundle do frontend, entao vale como senha da turma,
# nao como segredo: troque a cada semestre.
senha_compartilhada = "${SENHA_COMPARTILHADA}"

# Tags padrão para todos os recursos
tags = {
  Projeto    = "Gerenciador DNS"
  Ambiente   = "laboratorio"
  Gerenciado = "terraform"
}

# Preenchidos automaticamente pelo config.sh
id_zona_hospedada = ""
account_id        = ""
